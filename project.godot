; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="puzrpg"
run/main_scene="res://scenes/loading.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"
boot_splash/image="res://assets/ui/loading_candidates/loading_transparent_balls_dawn_v10.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

GameSession="*res://scripts/game_session.gd"
UIAudioManager="*res://scripts/ui_audio_manager.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
AudioSettings="*res://scripts/audio_settings.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="C:/Users/jaynap/Desktop/vids/005.avi"
export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom="res://resources/themes/level_select_theme.tres"

[mcp_toolkit]

status="No .mcp.json found — use Project > Tools > MCP Toolkit > Write .mcp.json to create one.

NODE.JS NOT FOUND — The MCP server bridge requires Node.js 22+. Download it from https://nodejs.org"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
2d/sleep_threshold_linear=3.0
2d/sleep_threshold_angular=0.1
2d/time_before_sleep=0.75
2d/solver/solver_iterations=24

[rendering]

rendering_device/driver.windows="opengl3"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
