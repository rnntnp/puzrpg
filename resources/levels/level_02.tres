[ext_resource type="Resource" path="res://resources/characters/blue_fighter.tres" id="2_player"]
[ext_resource type="Resource" path="res://resources/characters/red_fighter.tres" id="3_enemy"]
[ext_resource type="Resource" path="res://resources/characters/red_elite.tres" id="4_elite"]
