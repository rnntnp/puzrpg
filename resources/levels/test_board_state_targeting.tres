[ext_resource type="Script" path="res://scripts/test_gimmick_data.gd" id="5_gimmick"]
[ext_resource type="Texture2D" path="res://assets/backgrounds/stage_01_moonlit_pond.png" id="6_background"]
[ext_resource type="Texture2D" path="res://assets/level_previews/level_01_preview.png" id="7_preview"]
[ext_resource type="Texture2D" path="res://assets/effects/generated/status_attack.png" id="8_icon"]
