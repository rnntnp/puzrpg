[ext_resource type="Resource" path="res://resources/characters/targeting_analysis_boss.tres" id="10_boss"]
[ext_resource type="Script" path="res://scripts/gimmicks/handlers/board_state_targeting_handler.gd" id="11_handler"]
[ext_resource type="Script" path="res://scripts/gimmicks/configs/board_state_targeting_config.gd" id="12_config"]

[sub_resource type="Resource" id="TargetingConfig"]
script = ExtResource("12_config")
enemy_modes = Array[int]([0, 1, 2])
stage_loss = 1

[sub_resource type="Resource" id="Gimmick"]
script = ExtResource("5_gimmick")
kind = 31
display_name = "보드 상태 유도 타겟팅"
monster_health = 280
normal_attack_damage = 5
action_interval = 3
normal_attack_interval = 3
enemy_healths = Array[int]([220, 240, 280])
preserve_board_between_enemies = true
handler_script = ExtResource("11_handler")
tuning = SubResource("TargetingConfig")

[resource]
script = ExtResource("1_level")
level_name = "기믹 31 · 보드 상태 타겟팅"
image_placeholder = "BOARD STATE TARGETING"
battle_background = ExtResource("6_background")
level_select_preview = ExtResource("7_preview")
recommended_ball_level = 5
stage_gimmick_icon = ExtResource("8_icon")
