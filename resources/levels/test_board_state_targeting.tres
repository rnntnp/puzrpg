reward_name = "타겟 유도 플레이테스트"
player_character = ExtResource("2_player")
enemies = Array[ExtResource("4_character")]([ExtResource("3_height"), ExtResource("9_count"), ExtResource("10_boss")])
is_gimmick_test_level = true
test_gimmick = SubResource("Gimmick")
ball_drop_time_limit = -1.0
merge_hit_stop_time_scale = 0.18
merge_hit_stop_duration = 0.2
